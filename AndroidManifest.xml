<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zionaube.bloatless.browser"
    android:versionCode="4"
    android:versionName="1.3-ZionAube">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Bloatless" android:name=".ZionAubeBloatlessApplication" android:usesCleartextTraffic="true">
        <activity android:name=".ZionAubeBrowserMainActivity" android:label="@string/zion_aube_engine_label" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="@string/zion_aube_engine_label">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="@string/zion_aube_engine_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
        <service android:name=".ZionAubeTabBackgroundService" android:label="@string/zion_aube_service_label" android:exported="false" />
    </application>
</manifest>
